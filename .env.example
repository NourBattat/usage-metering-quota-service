# HTTP port used by the local development server.
PORT=3000

# Local Compose PostgreSQL credentials. Replace the placeholder locally;
# never commit a real .env file or production credentials.
POSTGRES_DB=usage_metering
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Required by the backend and the isolated demo-bootstrap service for
# POST /v1/accounts. It is never passed to the example-client service.
# Generate a unique local value with: openssl rand -hex 32
# Keep the actual value only in your ignored local .env file or shell environment.
PROVISIONING_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Compose uses its internal http://backend:3000 URL for bootstrap and the CLI.
# Do not add account API keys here; bootstrap hands each fresh key through the
# dedicated demo_api_key volume instead.

# For running the backend directly on the host with a separately reachable
# PostgreSQL instance (Compose keeps PostgreSQL private on its internal network):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=usage_metering
# PGUSER=usage_metering
# PGPASSWORD=replace-with-a-local-only-password
