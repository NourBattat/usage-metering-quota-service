# HTTP port used by the local development server.
PORT=3000

# Local Compose PostgreSQL credentials. Replace the placeholder locally;
# never commit a real .env file or production credentials.
POSTGRES_DB=usage_metering
POSTGRES_USER=usage_metering
POSTGRES_PASSWORD=replace-with-a-local-only-password

# For running the backend directly on the host with a separately reachable
# PostgreSQL instance (Compose keeps PostgreSQL private on its internal network):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=usage_metering
# PGUSER=usage_metering
# PGPASSWORD=replace-with-a-local-only-password
